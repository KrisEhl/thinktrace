# Nebius Token Factory (https://tokenfactory.nebius.com)
# Aliases also accepted: NEBIUS_TOKEN_FACTORY_API_KEY, MODEL_URL, MODEL_NAME
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Any Token Factory model with tool calling. List them: curl -H "Authorization: Bearer $NEBIUS_API_KEY" $NEBIUS_BASE_URL/models
NEBIUS_MODEL=MiniMaxAI/MiniMax-M3
# Optional: a different model for the adversarial fact-checker (e.g. Reflection AI Beam)
NEBIUS_CHECKER_MODEL=

# Tavily (https://app.tavily.com)
TAVILY_API_KEY=

PORT=3000
